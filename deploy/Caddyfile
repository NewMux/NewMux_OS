# Caddy fetches and renews a free Let's Encrypt certificate for $DOMAIN
# automatically (the domain must point at this server's IP).
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
