# Copied to deploy/.env by deploy/setup.sh (which fills in random secrets).

# Public address of the app. Before you have a domain, use <server-ip>.sslip.io
# (e.g. 141-147-10-20.sslip.io) — it still gets real HTTPS. Later change it to
# e.g. os.newmux.com after adding a DNS A record pointing at the server.
DOMAIN=

# Random strings: openssl rand -hex 32
POSTGRES_PASSWORD=
AUTH_SECRET=
VAULT_SESSION_SECRET=

# Optional: Paddle billing webhooks
PADDLE_WEBHOOK_SECRET=
