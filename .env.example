# --- Supabase / Postgres ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# --- Vault (AES-256-GCM) ---
# Server-only secret used to encrypt the derived vault key inside the short-lived
# vault_session cookie. Never reuse NEXTAUTH_SECRET for this.
VAULT_SESSION_SECRET=

# --- Paddle Billing ---
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
