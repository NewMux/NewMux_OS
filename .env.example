# --- Database ---
# Supabase: use the *pooled* (transaction mode, port 6543) connection string.
# Leave empty to use the embedded local database in .data/pglite.
DATABASE_URL=

# --- Auth (random 32+ byte strings: `openssl rand -hex 32`) ---
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Vault (AES-256-GCM) ---
# Encrypts the derived vault key inside the short-lived vault_session cookie.
# Never reuse AUTH_SECRET for this.
VAULT_SESSION_SECRET=

# --- Paddle Billing (optional) ---
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
