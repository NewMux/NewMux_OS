# --- Database ---
# Supabase: use the *pooled* (transaction mode, port 6543) connection string.
# Leave empty to use the embedded local database in .data/pglite.
DATABASE_URL=

# --- Auth (random 32+ byte strings: `openssl rand -hex 32`) ---
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Vault (AES-256-GCM) ---
# Encrypts the derived vault key inside the short-lived vault_session cookie.
# Never reuse AUTH_SECRET for this.
VAULT_SESSION_SECRET=

# --- Haman, the AI project manager (optional) ---
# A Claude API key from https://platform.claude.com. Without it the app works
# as before and "Ask Haman" says it isn't set up.
ANTHROPIC_API_KEY=
# Which Claude model answers until a partner picks one in Settings → Haman
# (default claude-opus-5-5).
HAMAN_MODEL=

# --- Push notifications (optional) ---
# Make all three with `npm run push:keys`. Without them, Settings → Notifications
# says it isn't set up and nothing is sent.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Lets the Cloudflare cron trigger call /api/cron/notifications (a server checks on its own).
CRON_SECRET=
# A contact address for the push services (default mailto:info@newmux.com).
VAPID_SUBJECT=

# --- Paddle Billing (optional) ---
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- OS updates: Haman and Claude Code changing NEWMUX OS (optional) ---
# A fine-grained GitHub token for the NEWMUX OS repository with Issues, Pull
# requests and Contents (read and write) and Checks (read). Without it,
# Settings → OS Updates says GitHub isn't connected. See docs/OS_UPDATES.md.
GITHUB_TOKEN=
# owner/name (default NewMux/NewMux_OS)
GITHUB_REPO=
# The branch pull requests go into (default: the repository's default branch,
# which should be the one Cloudflare deploys).
GITHUB_BRANCH=
